# === pad: VSA + template → MVSA (Fase A herstart) ===
# template: docs/specification-vsa-templates/library/tropaar-toon-4/template.yaml
# formule-notatie (mens, nog niet geparsed): tropaar-toon-4.formule.mvsa

# === afgeleide mvsa ===
@title "Kondak t.4 H. Profeet Hosea"
@do F4
@mode major
@oct S=0 A=0 T=-1 B=-1
@speelplan |: f1, f2 :| laatste
# Afgeleid: VSA (S) + tropaar-toon-4 template.yaml (A/T/B, slots)
# Mapper: vsa.template_instance.map_vsa_to_template

@blok f1  # template-frase '1' (1/5)
L: “Ver licht door de Hei_ li ge Geest,_ |
S: a - - - - bb - a |
A: f - - - - g - f# |
T: c - - - - d - - |
B: f - - - - g - d |
@blok f2  # template-frase '2' (2/5)
L: is uw zui ver hart een woon plaats ge wor den der pro_. fe tie;_ |
S: bb - - - - - - - - - - - - - a |
A: g - - - - - - - - - - - - - f |
T: d - - - - - - - - - - - - c - |
B: g - - - - - - - - - - - - c f |
@blok f1  # template-frase '1' (3/5)
L: want nog ver re ge beur te nis sen hebt gij als te gen woor_ dig ge schouwd,_ |
S: a - - - - - - - - - - - - - - bb - a |
A: f - - - - - - - - - - - - - - g - f# |
T: c - - - - - - - - - - - - - - d - - |
B: f - - - - - - - - - - - - - - g - d |
@blok f2  # template-frase '2' (4/5)
L: daar om ver e_ ren wij u,_ |
S: bb - - - - - a |
A: g - - - - - f |
T: d - - - c - - |
B: g - - - c - f |
@blok laatste  # template-frase 'laatste' (5/5)
L: roem rij ke Pro feet, ge ze gen de Ho se_ __ a_ |
S: a - - - - - - - - - - g a |
A: f - - - - - - - - - - e f |
T: c - - - - - - - - - - - - |
B: f - - - - - - - - - - c f |

