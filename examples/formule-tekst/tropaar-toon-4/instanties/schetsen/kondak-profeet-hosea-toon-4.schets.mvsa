@title "Kondak t.4 H. Profeet Hosea"
@do F4
@mode major
@oct S=0 A=0 T=-1 B=-1
@speelplan 1, 2, 3, 4, 5

# template-frase '1' (1/5)
@blok 1
L: “Ver licht door de Hei_ li ge Geest,_ |
S: a - - - - bb - a |
A: f - - - - g - f# |
T: c - - - - d - - |
B: f - - - - g - d |
# template-frase '2' (2/5)
@blok 2
L: is uw zui ver hart een woon plaats ge wor den der pro_. fe tie;_ |
S: bb - - - - - - - - - - - - - a |
A: g - - - - - - - - - - - - - f |
T: d - - - - - - - - - - - - c - |
B: g - - - - - - - - - - - - c f |
# template-frase '1' (3/5)
@blok 3
L: want nog ver re ge beur te nis sen hebt gij als te gen woor_ dig ge schouwd,_ |
S: a - - - - - - - - - - - - - - bb - a |
A: f - - - - - - - - - - - - - - g - f# |
T: c - - - - - - - - - - - - - - d - - |
B: f - - - - - - - - - - - - - - g - d |
# template-frase '2' (4/5)
@blok 4
L: daar om ver e_ ren wij u,_ |
S: bb - - - - - a |
A: g - - - - - f |
T: d - - - c - - |
B: g - - - c - f |
# template-frase 'laatste' (5/5)
@blok 5
L: roem rij ke Pro feet, ge ze gen de Ho se_&_ a_ |
