# Oefenstuk: hard/zacht én langzaam/snel via L-uitvoeraanwijzingen
# Zie docs/specification-mvsa/uitvoeraanwijzingen.md

@title "Hard en zacht, langzaam en snel"
@composer "Voorbeeld (VSA-tooling)"
@bron "oefenstuk uitvoeraanwijzingen"
@copyright "CC0 1.0 (voorbeeld, vrij te gebruiken)"
@tempo 60 "Langzaam"
@do F4
@mode major
@oct S=0 A=0 T=-1 B=-1

@sectie zacht-langzaam
L: [p]Zacht_ en stil_[//_] |
S: do    re  mi_           |
A: do    -   do_           |
T: do    -   do_           |
B: do    -   do_           |

@tempo 96 "Andante"
@sectie crescendo
L: [mf][cresc]Dan_ klinkt_ het_ ster_-ker_[/cresc] |
S: do         re   mi_  fa_  sol_                  |
A: do         -    do_  -    do_                   |
T: do         -    do_  -    do_                   |
B: do         -    do_  -    do_                   |

@tempo 144 "Vlug"
@sectie hard-snel
L: [f]Hard_ en snel_[adem] |
S: sol_ fa  mi_            |
A: mi_  re  do_            |
T: do_  -   do_            |
B: do_  sol do_            |

@tempo 72 "Langzaam"
@sectie rit-slot
L: [rit][dim]Nu_ weer_ zach_-ter_[/dim] [atempo][pp]A_-men_[ferm] ||
S: sol       fa  mi_   re_              do          -             ||
A: mi_       re  do_   -                do          -             ||
T: do_       -   do_   -                do          -             ||
B: do_       sol do_   -                do          -             ||
