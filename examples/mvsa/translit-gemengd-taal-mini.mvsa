# Mini-voorbeeld: gemengd nl + ksl met @taal (fase 3)

@do F4
@mode major
@title "Hulptekst gemengd @taal"
@oct S=0 A=0 T=-1 B=-1

@taal nl
L: Heer_ ont-ferm_ U_ |
S: a4    -   -     -  |
A: f4    -   -     -  |
T: c4    -   -     -  |
B: f3    -   -     -  |

@taal ksl
L: Гос-по-ди_ по-ми-луй_ |
S: a4  -  -   -  -  -    |
A: f4  -  -   -  -  -    |
T: c4  -  -   -  -  -    |
B: f3  -  -   -  -  -    |
